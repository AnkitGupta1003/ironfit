    carouselEl.addEventListener('mouseenter', stop);
    carouselEl.addEventListener('mouseleave', start);
    carouselEl.addEventListener('focusin', stop);
    carouselEl.addEventListener('focusout', function (e) {
      if (!carouselEl.contains(e.relatedTarget)) { start(); }
    });
    document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start(); });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (es) {
        es.forEach(function (en) { en.isIntersecting ? start() : stop(); });
      }, { threshold: 0.3 }).observe(carouselEl);
    }
    go(0, false);
  }

  /* ---------- Plan / class / trainer prefill ---------- */
  var select = $('#f-interest');
  var msg = $('#f-message');
  var fieldsWrap = $('.form-fields');
  var successBox = $('.form-success');

  function showForm() {
    fieldsWrap.hidden = false;
    successBox.hidden = true;
  }

  $$('[data-plan]').forEach(function (el) {
    el.addEventListener('click', function () {
      var plan = el.getAttribute('data-plan');
      var prefill = el.getAttribute('data-prefill');
      var toastMsg = el.getAttribute('data-toast');
      if (fieldsWrap && fieldsWrap.hidden) { showForm(); }
      if (select && plan) {
        for (var i = 0; i < select.options.length; i++) {
          if (select.options[i].value === plan) { select.value = plan; break; }
        }
        clearError(select);
      }
      if (msg && prefill && (!msg.value.trim() || msg.getAttribute('data-prefilled') === '1')) {
        msg.value = prefill;
        msg.setAttribute('data-prefilled', '1');
      }
      if (toastMsg) { toast(toastMsg); }
      if (finePointer) {
        setTimeout(function () { var n = $('#f-name'); if (n) { n.focus({ preventScroll: true }); } }, 700);
      }
    });
  });
  if (msg) {
    msg.addEventListener('input', function () { msg.removeAttribute('data-prefilled'); });
  }

  /* ---------- Contact form ---------- */
  var form = $('#contact-form');
  function fieldOf(input) { return input.closest('.field'); }
  function setError(input, message) {
    var wrap = fieldOf(input);
    if (!wrap) { return; }
    var err = wrap.querySelector('.field-error');
    wrap.classList.add('has-error');
    input.setAttribute('aria-invalid', 'true');
    if (err) { err.textContent = message; }
  }
  function clearError(input) {
    var wrap = fieldOf(input);
    if (!wrap) { return; }
    wrap.classList.remove('has-error');
    input.removeAttribute('aria-invalid');
  }
  if (form) {
    var nameI = $('#f-name'), emailI = $('#f-email'), phoneI = $('#f-phone');
    [nameI, emailI, phoneI, select].forEach(function (i) {
      if (!i) { return; }
      i.addEventListener('input', function () { clearError(i); });
      i.addEventListener('change', function () { clearError(i); });
    });
    function validate() {
      var ok = true;
      if (nameI.value.trim().length < 2) { setError(nameI, 'Please tell us your name.'); ok = false; }
      var em = emailI.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(em)) { setError(emailI, "That email doesn't look right — mind checking it?"); ok = false; }
      var ph = phoneI.value.trim();
      if (ph && !/^[+()\-.\s\d]{7,20}$/.test(ph)) { setError(phoneI, 'That phone number looks off.'); ok = false; }
      if (!select.value) { setError(select, 'Pick what you\u2019re interested in.'); ok = false; }
      return ok;
    }
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!validate()) {
        var firstErr = $('.field.has-error input, .field.has-error select');
        if (firstErr) { firstErr.focus(); }
        return;
      }
      var btn = form.querySelector('.btn-submit');
      btn.disabled = true;
      btn.classList.add('is-loading');
      setTimeout(function () {
        fieldsWrap.hidden = true;
        var first = nameI.value.trim().split(/\s+/)[0];
        $('#success-name').textContent = first ? ', ' + first : '';
        successBox.hidden = false;
        toast("Message sent — we'll be in touch within one business day.");
        btn.disabled = false;
        btn.classList.remove('is-loading');
      }, 1100);
    });
    var resetBtn = $('#form-reset');
    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        form.reset();
        if (msg) { msg.removeAttribute('data-prefilled'); }
        showForm();
        nameI.focus();
      });
    }
  }

  /* ---------- Footer year ---------- */
  var yearEl = $('#year');
  if (yearEl) { yearEl.textContent = String(new Date().getFullYear()); }
})();
</script>
</body>
</html>
