  }

  /* ---------- Cursor-following class preview (desktop) ---------- */
  var preview = $('#class-preview');
  if (preview && finePointer && !prefersReduced && window.innerWidth >= 1024) {
    var pImg = preview.querySelector('img');
    $$('.class-item').forEach(function (it) { var i = new Image(); i.src = it.getAttribute('data-img'); });
